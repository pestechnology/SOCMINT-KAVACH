# ============================================================
# VERTEX / CIDECODE — Environment Variables (EXAMPLE / TEMPLATE)
# ------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill .env with your REAL keys (see the "GET IT:" note above each one).
#      A step-by-step walkthrough with screenshots-worth of detail is in GET_API_KEYS.md.
#   3. The .env file is gitignored — it never gets committed. NEVER paste real keys
#      into chat, screenshots, commits, or Slack. If one leaks, ROTATE it.
#
# NO KEYS YET? Set DATA_MODE=mock below and the whole demo runs offline with zero keys.
# ============================================================

# ---- Data Mode ----
# "live" = real scrapes (needs the 3 required keys below).
# "mock" = fixed offline test data, NO keys needed (great for a first run / demo).
DATA_MODE=live
DEMO_FALLBACK_ENABLED=True

# ============================================================
# REQUIRED KEYS (all free)  —  live mode needs ALL of these for the project to run
# well. Get every one; the app is designed to run at full capability with them set.
# ============================================================

# SERPER — Google search results (the widest OSINT net).
# GET IT: https://serper.dev  ->  "Sign up" (Google login)  ->  dashboard shows
#         "API Key". Copy it. Free tier = 2,500 searches. Paste after the = below.
SERPER_API_KEY=your_serper_key_here

# GITHUB — read public GitHub profiles/followers without hitting the rate limit.
# GET IT: github.com  ->  your avatar (top-right)  ->  Settings  ->  Developer settings
#         (bottom of left menu)  ->  Personal access tokens  ->  Tokens (fine-grained)
#         ->  "Generate new token"  ->  name it, pick an expiry, leave permissions at
#         default (public data only), Generate  ->  copy the token (starts with github_pat_).
GITHUB_TOKEN=your_github_pat_here

# NVIDIA — the default LLM (fact extraction + explanations). Free tier available.
# GET IT: https://build.nvidia.com/  ->  sign in  ->  pick any model  ->  "Get API Key"
#         / "Generate Key"  ->  copy the key (starts with nvapi-).
# (VERTEX works with ANY OpenAI-compatible LLM — local or cloud. NVIDIA is just the
#  free default; to use another, change NVIDIA_BASE_URL + the model, see GET_API_KEYS.md.)
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NUMVERIFY — phone number validation / carrier / country. Free tier.
# GET IT: https://numverify.com  ->  "Sign Up Free"  ->  dashboard  ->  "API Access Key".
NUMVERIFY_KEY=your_numverify_key_here

# ============================================================
# OPTIONAL EXTRAS  —  the project runs fully without these.
# ============================================================

# HIBP — "Have I Been Pwned" breach lookup. OPTIONAL and PAID (~$4/mo).
# The project runs fine without this — it just adds extra breach coverage. Skip it
# unless you specifically want HIBP breach data.
# GET IT: https://haveibeenpwned.com/API/Key  ->  purchase  ->  copy key.
HIBP_API_KEY=your_hibp_key_here

# ============================================================
# TELEGRAM  —  REQUIRED for the phone-lookup feature (its own setup step, below).
# Not just a pasted key: needs a phone-verified Telegram account AND a one-time
# interactive login. Full steps in GET_API_KEYS.md / API_KEYS_AND_BOTS.md.
# ============================================================

# GET IT: https://my.telegram.org  ->  log in with your phone  ->  "API development tools"
#         ->  fill the short form  ->  it shows "App api_id" and "App api_hash". Copy both.
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ---- NewLeaks OSINT bot add-on (optional breach/PII source via @NewleaksOsintBot) ----
# OFF by default. This one is NOT just a key — it needs a one-time interactive login:
#   1. Set TELEGRAM_API_ID / TELEGRAM_API_HASH above (real values).
#   2. Run once:  python -m scripts.telegram_login   (Docker: see DOCKER.md)
#      -> it asks for your phone + the code Telegram texts you, and saves a session file.
#   3. Set NEWLEAKS_ENABLED=true below and restart.
# The session logs into YOUR Telegram account — never share the session file.
NEWLEAKS_ENABLED=false
NEWLEAKS_BOT_USERNAME=NewleaksOsintBot
NEWLEAKS_API_KEY=your_newleaks_bot_api_key_here
NEWLEAKS_TIMEOUT_SECONDS=25
# TELEGRAM_USER_SESSION=/absolute/path/to/user_session   # optional; defaults to <repo>/user_session

# ---- Paths (leave as-is unless you know why) ----
SYNTHETIC_DATA_PATH=data/synthetic_dataset.json
DB_PATH=cidecode.db
REPORT_OUTPUT_DIR=reports/

# ---- Auth ----
# JWT_SECRET signs login tokens. You MUST change this from the default.
# GENERATE ONE:  python -c "import secrets; print(secrets.token_hex(32))"
# ...then paste the output after the = below.
JWT_SECRET=change_me_to_a_random_32_char_string
TOKEN_EXPIRY_HOURS=8
