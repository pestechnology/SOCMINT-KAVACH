# ============================================================
# VERTEX / CIDECODE — Environment Variables (EXAMPLE / TEMPLATE)
# ------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill .env with your REAL keys (the .env file is gitignored — it never gets committed)
#   3. NEVER paste real keys into chat, screenshots, commits, or Slack.
#
# NOTE: every value below is a placeholder. Replace with freshly-generated keys.
#       (If any real key was ever exposed, ROTATE it before using.)
# ============================================================

# ---- Data Mode ----
# "live"  = real scrapes (used on stage). "mock" = fixed test data (development only).
DATA_MODE=live
DEMO_FALLBACK_ENABLED=True

# ---- Required API Keys ----
SERPER_API_KEY=your_serper_key_here
GITHUB_TOKEN=your_github_pat_here
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Optional (recommended) ----
HIBP_API_KEY=your_hibp_key_here
NUMVERIFY_KEY=your_numverify_key_here

# ---- Telegram (Telethon) ----
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ---- Paths ----
SYNTHETIC_DATA_PATH=data/synthetic_dataset.json
DB_PATH=cidecode.db
REPORT_OUTPUT_DIR=reports/

# ---- Auth ----
# Generate a random 32+ char string, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_32_char_string
TOKEN_EXPIRY_HOURS=8
