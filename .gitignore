# ============================================================
# VERTEX .gitignore — keep secrets, junk, and big files OUT of git
# ============================================================

# ---- SECRETS — never commit these ----
.env
.env.*
!.env.example
*.session
*.session-journal
*.pem
*.key
secrets.json
credentials.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Databases (regenerable) ----
*.db
*.sqlite
*.sqlite3
cidecode.db
vertex.db

# ---- Scraper output / generated artifacts ----
reports/
report_*.json
data/synthetic_dataset.json
artifacts/
*.har
# Blackbird itself is cloned locally per SETUP.md (git clone .../blackbird
# tools/blackbird) - it's its own separate repo, never this repo's content.
tools/blackbird/
# OnionSearch sandbox's per-run search output (docker-compose.yml creates this dir
# via its volume mount; nothing under it belongs in version control).
tools/onionsearch-sandbox/output/
# Rendered PDF copies of the *.md docs below aren't committed — the .md is the
# source of truth; render your own copy locally if you want a PDF to hand out.
VERTEX_Feature_Walkthrough.pdf
VERTEX_Features_Reference.pdf
VERTEX_Tools_Reference.pdf

# ---- Pretrained model binaries (downloaded by setup, not committed) ----
backend/models/*.onnx

# ---- Node / Next.js frontend ----
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Editor / OS ----
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---- Logs ----
*.log
logs/

# ---- Local tooling / scratch ----
.claude/
.serena/
scratchpad/

# ---- local pitch working files ----
VERTEX-pitch/
SESSION_LOG_*.md
SESSION_LOG_*.pdf
